# ============================================================
# PUBLIC / BROWSER-SIDE CONFIGURATION
# These values are exposed to the browser via NEXT_PUBLIC_ prefix.
# ============================================================

# Your Sitecore CDP/Personalize Context ID.
# Found in Sitecore CDP under: Administration > API Access > Context ID
NEXT_PUBLIC_SITECORE_EDGE_CONTEXT_ID=your-context-id-here

# Your Sitecore site name as configured in CDP.
NEXT_PUBLIC_SITECORE_SITE_NAME=your-site-name-here

# ============================================================
# SERVER-ONLY CONFIGURATION (NEVER expose to browser)
# ============================================================

# Sitecore Personalize Client Key for server-side Flow Execution API calls.
# Found in Sitecore Personalize under: Settings > API Access > Client Key
SITECORE_PERSONALIZE_CLIENT_KEY=your-client-key-here

# Your Personalize point of sale / tenant identifier.
SITECORE_PERSONALIZE_POINT_OF_SALE=your-pos-here